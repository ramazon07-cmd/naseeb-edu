# Copy these names into your deployment provider's secret/environment settings.
# Do not commit a real .env file or real credentials.
APP_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DATABASE_URL=postgresql://user:password@host:5432/database
ENABLE_DEMO_ACCOUNTS=False
DEMO_PARENT_PASSWORD=replace-with-a-strong-demo-only-password
API_ANON_RATE=60/hour
API_USER_RATE=1200/hour
AI_ASSISTANT_ENABLED=True
AI_ASSISTANT_RATE=20/hour
# Store the real value in your deployment provider's backend secret manager.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_ASSISTANT_MODEL=openai/gpt-5.4-mini
AI_ASSISTANT_FALLBACK_MODEL=openai/gpt-5.4-nano
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_RECOMMENDATION_MODEL=openai/gpt-oss-20b
AI_RECOMMENDATION_TIMEOUT_SECONDS=30
AI_ASSISTANT_MAX_MESSAGES=12
AI_ASSISTANT_MAX_INPUT_CHARS=6000
AI_ASSISTANT_MAX_OUTPUT_TOKENS=450
AI_ASSISTANT_TIMEOUT_SECONDS=35
# Total time for one streamed reply, streams per gunicorn process (below
# GUNICORN_THREADS) and concurrent streams per user.
AI_STREAM_MAX_SECONDS=60
AI_MAX_STREAMS_PER_PROCESS=4
AI_USER_MAX_CONCURRENT_STREAMS=2
SCREEN_TIME_RETENTION_DAYS=365
TEMPORARY_CREDENTIAL_TTL_HOURS=72
# Sign-in attempts per (account, IP), a generous per-IP ceiling for schools and
# carrier NAT, and an account-wide ceiling that addresses which already signed
# in to the account skip. Token refresh is limited per refresh token.
AUTH_LOGIN_RATE=10/minute
AUTH_LOGIN_ACCOUNT_RATE=60/minute
AUTH_LOGIN_IP_RATE=300/minute
AUTH_REFRESH_RATE=30/hour
AUTH_REFRESH_IP_RATE=600/minute
# Trusted reverse proxies in front of Django (Render = 1, bare local server = 0).
NUM_PROXIES=1
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900
# Optional comma-separated IP allowlist for /admin/ (empty = unrestricted).
ADMIN_ALLOWED_IPS=
AUTH_PASSWORD_CHANGE_RATE=5/hour
AUTH_CREDENTIAL_ISSUE_RATE=20/hour
# Public landing-page reach aggregate (/api/public/reach/).
PUBLIC_REACH_RATE=60/minute
PUBLIC_REACH_MIN_CELL=5
# Uploaded files live in a private S3-compatible bucket (AWS S3 or Cloudflare
# R2) so several instances can serve them. See docs/scaling.md "File storage".
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=naseeb-files
# Optional separate bucket for student documents (defaults to the one above).
AWS_PRIVATE_STORAGE_BUCKET_NAME=
# R2: https://<account-id>.r2.cloudflarestorage.com and region "auto".
# AWS: leave the endpoint empty and set the bucket's region.
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=replace-with-bucket-access-key
AWS_SECRET_ACCESS_KEY=replace-with-bucket-secret-key
# Seconds a presigned download URL stays valid after authorisation.
PRIVATE_FILE_URL_EXPIRE_SECONDS=60
# Only for a single instance on a persistent disk (STORAGE_BACKEND=filesystem):
# FILE_STORAGE_SINGLE_INSTANCE=True
# MEDIA_ROOT=/app/backend/media
# DOCUMENT_STORAGE_ROOT=/app/backend/private_documents
DOCUMENT_MAX_UPLOAD_SIZE=26214400
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.rtf,.odt,.ods,.odp,.png,.jpg,.jpeg,.webp,.heic
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
# Shared cache (required with more than one worker/instance).
REDIS_URL=redis://red-xxxxxxxx:6379
# Seconds before a Redis call gives up (throttles then fail open).
REDIS_CONNECT_TIMEOUT=0.25
REDIS_SOCKET_TIMEOUT=0.25
# Behind PgBouncer (transaction mode): DATABASE_URL points at PgBouncer,
# DIRECT_DATABASE_URL at the database itself (migrations and job locks).
PGBOUNCER=
DIRECT_DATABASE_URL=
# Optional error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.02
# Gunicorn gthread sizing and the per-process PostgreSQL pool.
# Connections per instance = WEB_CONCURRENCY x DB_POOL_MAX_SIZE.
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT=10
LOG_LEVEL=INFO
AVATAR_MAX_UPLOAD_SIZE=2097152
# Content-Length cap for any request (default: DOCUMENT_MAX_UPLOAD_SIZE + 1 MB).
MAX_REQUEST_BODY_SIZE=27262976
# Daily caps on paid AI calls: platform-wide, per school, per user (0 = no cap,
# except ESSAY_COACH_DAILY_BUDGET=0, which turns the AI coach off).
AI_ASSISTANT_DAILY_BUDGET=5000
AI_ASSISTANT_SCHOOL_DAILY_BUDGET=1000
AI_ASSISTANT_USER_DAILY_LIMIT=60
ESSAY_COACH_DAILY_BUDGET=5000
ESSAY_COACH_SCHOOL_DAILY_BUDGET=1000
ESSAY_COACH_USER_DAILY_LIMIT=40
# Paid AI calls each process may still make per day while Redis is down (0 = none).
AI_FALLBACK_PROCESS_DAILY_BUDGET=20
