# Copy these names into your deployment provider's secret/environment settings.
# Do not commit a real .env file or real credentials.
APP_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DATABASE_URL=postgresql://user:password@host:5432/database
ENABLE_DEMO_ACCOUNTS=False
DEMO_PARENT_PASSWORD=replace-with-a-strong-demo-only-password
API_ANON_RATE=60/hour
API_USER_RATE=1200/hour
AI_ASSISTANT_ENABLED=True
AI_ASSISTANT_RATE=20/hour
# Store the real value in your deployment provider's backend secret manager.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_ASSISTANT_MODEL=openai/gpt-5.4-mini
AI_ASSISTANT_FALLBACK_MODEL=openai/gpt-5.4-nano
AI_ASSISTANT_MAX_MESSAGES=12
AI_ASSISTANT_MAX_INPUT_CHARS=6000
AI_ASSISTANT_MAX_OUTPUT_TOKENS=450
AI_ASSISTANT_TIMEOUT_SECONDS=35
SCREEN_TIME_RETENTION_DAYS=365
TEMPORARY_CREDENTIAL_TTL_HOURS=72
AUTH_LOGIN_RATE=10/minute
AUTH_PASSWORD_CHANGE_RATE=5/hour
AUTH_CREDENTIAL_ISSUE_RATE=20/hour
MEDIA_ROOT=/app/backend/media
DOCUMENT_STORAGE_ROOT=/app/backend/private_documents
DOCUMENT_MAX_UPLOAD_SIZE=26214400
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.rtf,.odt,.ods,.odp,.png,.jpg,.jpeg,.webp,.heic
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
