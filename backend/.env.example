APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
ENABLE_DEMO_ACCOUNTS=True
DEMO_COUNSELOR_PASSWORD=admin12345
DEMO_ORGANIZATION_PASSWORD=school12345
DEMO_STUDENT_PASSWORD=student12345
DEMO_PARENT_PASSWORD=parent12345
API_ANON_RATE=60/hour
API_USER_RATE=1200/hour
AI_ASSISTANT_ENABLED=True
AI_ASSISTANT_RATE=20/hour
# Backend secret only. Leave blank to use the built-in no-provider guidance fallback.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_ASSISTANT_MODEL=openai/gpt-5.4-mini
AI_ASSISTANT_FALLBACK_MODEL=openai/gpt-5.4-nano
AI_COLLEGE_MODEL=openai/gpt-5.4-nano
AI_COLLEGE_MAX_OUTPUT_TOKENS=260
AI_ASSISTANT_MAX_MESSAGES=12
AI_ASSISTANT_MAX_INPUT_CHARS=6000
AI_ASSISTANT_MAX_OUTPUT_TOKENS=450
AI_ASSISTANT_TIMEOUT_SECONDS=35
SCREEN_TIME_RETENTION_DAYS=365
TEMPORARY_CREDENTIAL_TTL_HOURS=72
AUTH_LOGIN_RATE=10/minute
AUTH_PASSWORD_CHANGE_RATE=5/hour
AUTH_CREDENTIAL_ISSUE_RATE=20/hour
# Public landing-page reach aggregate (/api/public/reach/), the only
# unauthenticated endpoint. PUBLIC_REACH_MIN_CELL=0 publishes exact per-region
# counts; raising it hides counts below the threshold while keeping the region
# flagged as covered.
PUBLIC_REACH_RATE=60/minute
PUBLIC_REACH_MIN_CELL=0
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
MEDIA_ROOT=
DOCUMENT_STORAGE_ROOT=
DOCUMENT_MAX_UPLOAD_SIZE=26214400
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.rtf,.odt,.ods,.odp,.png,.jpg,.jpeg,.webp,.heic
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
